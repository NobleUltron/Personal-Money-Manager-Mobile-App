{
    "name":  "personal-money-manager-api",
    "version":  "1.0.0",
    "description":  "Personal Money Manager - NestJS REST API with Prisma \u0026 Swagger",
    "private":  true,
    "scripts":  {
                    "build":  "npx prisma generate \u0026\u0026 npx nest build",
                    "render:build":  "npm install --include=dev \u0026\u0026 npx prisma generate \u0026\u0026 npm run build",
                    "format":  "prettier --write \"src/**/*.ts\"",
                    "start":  "nest start",
                    "start:dev":  "nest start --watch",
                    "start:debug":  "nest start --debug --watch",
                    "start:prod":  "node dist/main",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:studio":  "prisma studio"
                },
    "dependencies":  {
                         "@nestjs/common":  "^11.0.10",
                         "@nestjs/config":  "^4.0.0",
                         "@nestjs/core":  "^11.0.10",
                         "@nestjs/jwt":  "^11.0.0",
                         "@nestjs/passport":  "^11.0.5",
                         "@nestjs/platform-express":  "^11.0.10",
                         "@nestjs/swagger":  "^11.0.5",
                         "@prisma/client":  "^6.4.1",
                         "bcryptjs":  "^3.0.2",
                         "class-transformer":  "^0.5.1",
                         "class-validator":  "^0.14.1",
                         "cors":  "^2.8.5",
                         "helmet":  "^8.0.0",
                         "nodemailer":  "^6.10.0",
                         "passport":  "^0.7.0",
                         "passport-jwt":  "^4.0.1",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.1",
                         "@nestjs/cli":  "^11.0.4",
                         "prisma":  "^6.4.1",
                         "typescript":  "^5.7.3"
                     },
    "devDependencies":  {
                            "@nestjs/cli":  "^11.0.4",
                            "@nestjs/schematics":  "^11.0.1",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/express":  "^5.0.0",
                            "@types/node":  "^22.13.5",
                            "@types/nodemailer":  "^6.4.17",
                            "@types/passport-jwt":  "^4.0.1",
                            "prisma":  "^6.4.1",
                            "ts-loader":  "^9.5.2",
                            "ts-node":  "^10.9.2",
                            "tsconfig-paths":  "^4.2.0",
                            "typescript":  "^5.7.3"
                        }
}