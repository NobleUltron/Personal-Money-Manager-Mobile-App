{
  "expo": {
    "name": "Personal Money Manager",
    "slug": "personal-money-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "personal-money-manager",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personalmoneymanager.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Personal Money Manager to use Face ID to securely unlock your financial data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      },
      "package": "com.personalmoneymanager.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "./plugins/withCustomApkName"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c30e3a28-66f7-450d-bf98-672f9da34108"
      }
    },
    "icon": "./assets/images/icon.png",
    "owner": "noble_muwonge"
  }
}
