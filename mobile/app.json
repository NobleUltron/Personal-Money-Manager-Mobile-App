{
  "expo": {
    "name": "Personal Money Manager",
    "slug": "personal-money-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "personal-money-manager",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personalmoneymanager.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Personal Money Manager to use Face ID to securely unlock your financial data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617"
      },
      "package": "com.personalmoneymanager.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "./plugins/withCustomApkName"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6906906-9f8b-4d0c-b019-53dee6aef382"
      }
    },
    "icon": "./assets/images/icon.png"
  }
}